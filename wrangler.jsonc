{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gogo-cms-dev",
  "main": "worker/index.ts",
  // Runs before upload, so the deploy does not depend on a build command set
  // by hand in the Cloudflare dashboard — `dist/` is gitignored and would
  // otherwise never exist on the build machine.
  "build": { "command": "pnpm build" },
  "compatibility_date": "2026-08-26",
  // Cloudflare Access guards the custom domain only (GoGo-Infra
  // cloudflare-cms-hosting). Left unset, `wrangler deploy` turns on
  // *.workers.dev and preview URLs, which serve the same admin console at a
  // hostname Access never sees. Only `wrangler deploy` / `triggers deploy`
  // apply these keys: the DEV pipeline (`versions upload` + `versions deploy`)
  // leaves whatever the account already has, so this file guards the manual
  // path, not the live state.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // React Router owns the URL space: /audit and /places/:id must serve the
    // app shell, not a 404, on a direct load or a refresh.
    "not_found_handling": "single-page-application",
    // Without this the SPA fallback would answer /v1/* with index.html before
    // the Worker ever saw the request, and every API call would "succeed"
    // with HTML.
    "run_worker_first": ["/v1/*"],
  },
  "observability": { "enabled": true },
  "vars": {
    // Set per environment in the Cloudflare dashboard (or `wrangler secret`
    // if the origin itself is not public knowledge). Empty here on purpose:
    // committing an environment's hostname makes it look like a contract.
    "BE_ORIGIN": "",
  },
}
