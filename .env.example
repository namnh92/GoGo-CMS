# Base URL of the GoGo-BE BFF contract. Same-origin in production so the
# session cookie (HttpOnly, SameSite=Lax) is sent without CORS exceptions.
VITE_API_BASE_URL=/v1

# Origin the Vite dev-server proxy forwards /v1 to. DEV is deployed, not local:
# nothing here needs GoGo-BE, PostgreSQL or Redis on the machine.
# http://localhost:3000 only when deliberately debugging GoGo-BE itself.
VITE_API_ORIGIN=https://api-dev.gogo.id.vn

# Run the whole CMS against MSW fixtures (no backend required).
VITE_USE_MOCK=true

# Never put secrets, API keys or tokens in this file. Vite inlines every
# VITE_* variable into the client bundle.

# Which deployment this build is. dev | staging | production.
# Drives the environment badge and the production warning banner. Never
# inferred from the hostname: a preview domain or a tunnel would lie.
VITE_APP_ENV=dev
